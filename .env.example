# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ActiveCampaign
ACTIVECAMPAIGN_URL="https://your-account.api-us1.com"
ACTIVECAMPAIGN_API_KEY="your-api-token"
# Opcional: nome da tag aplicada em todo contato vindo deste formulário.
# Padrão se não configurada: "IPDCON 2026 - Formulário"
ACTIVECAMPAIGN_TAG_NAME="IPDCON 2026 - Formulário"

# URL pública do site (usada em metadata/sitemap/robots)
NEXT_PUBLIC_SITE_URL="https://ipdcon.allparty.com.br"

# Chave usada pelo sistema interno para ler /api/registrations.
# Gere uma string aleatória longa, ex: openssl rand -hex 32
INTERNAL_API_KEY="generate-a-long-random-secret"
