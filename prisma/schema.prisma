generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id           String   @id @default(cuid())
  nome         String
  email        String
  telefone     String
  empresa      String?
  cargo        String?
  segmento     String?
  autorizo     Boolean  @default(false)
  syncedToAC   Boolean  @default(false)
  createdAt    DateTime @default(now())
}
